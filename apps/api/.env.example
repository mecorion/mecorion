HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://mecorion:mecorion@127.0.0.1:5432/mecorion
MEDIA_STORAGE_ROOT=../../data
MEDIA_MAX_UPLOAD_BYTES=536870912
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

NODE_ENV=development
# required — настоящие JWT/seed-сессии; dev-bypass — локальная разработка без входа.
AUTH_MODE=required
DEV_AUTH_ACCOUNT=dev-admin
JWT_MODE=keypair
JWT_PRIVATE_KEY_PATH=../../infrastructure/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../infrastructure/keys/jwt-public.pem
# JWT_SECRET используется только при JWT_MODE=secret в тестовой среде.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_SEED_PEPPER=change-me-seed-word-pepper
AUTH_COOKIE_DOMAIN=
ADMIN_BOOTSTRAP_TOKEN=change-me-for-first-admin

MAIL_DEV_MODE=true
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mecorion.local
