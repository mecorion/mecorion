{
  "name": "mecorion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @mecorion/web run dev --",
    "build": "npm --workspace @mecorion/web run build",
    "ui:check": "npm --workspace @mecorion/web run ui:check",
    "preview": "npm --workspace @mecorion/web run preview",
    "admin:dev": "npm --workspace @mecorion/admin run dev --",
    "admin:build": "npm --workspace @mecorion/admin run build",
    "admin:preview": "npm --workspace @mecorion/admin run preview",
    "api:dev": "npm --workspace @mecorion/api run dev",
    "api:dev:auth": "node apps/api/scripts/dev-mode.mjs required",
    "api:dev:no-auth": "node apps/api/scripts/dev-mode.mjs dev-admin",
    "api:dev:no-auth:base": "node apps/api/scripts/dev-mode.mjs dev-base",
    "api:build": "npm --workspace @mecorion/api run build",
    "api:typecheck": "npm --workspace @mecorion/api run typecheck",
    "api:test": "npm --workspace @mecorion/api run test",
    "auth:keys": "npm --workspace @mecorion/api run auth:keys",
    "worker:dev": "npm --workspace @mecorion/media-worker run dev",
    "worker:build": "npm --workspace @mecorion/media-worker run build",
    "db:up": "docker compose -f infrastructure/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "npm --workspace @mecorion/api run db:migrate",
    "db:seed": "npm --workspace @mecorion/api run db:seed",
    "db:test": "npm --workspace @mecorion/api run db:test",
    "admin:check": "npm run api:typecheck && npm run api:test && npm run admin:build",
    "typecheck": "npm --workspace @mecorion/api run typecheck && npm --workspace @mecorion/media-worker run typecheck",
    "generate": "npm --workspace @mecorion/web run generate",
    "web:test:smoke": "npm --workspace @mecorion/web run test:smoke"
  }
}
